<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10</LangVersion>
    <AssemblyName>chaossan-questmarkerslinux</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <!-- keep personal build paths out of published DLL/PDB -->
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)'))=/src/questmarkerslinux</PathMap>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!-- Path to your SPT install: pass -p:SptPath=/path/to/SPT, export
         SPT_PATH, or drop a private plugin/Directory.Build.props defining
         SptPath (git-ignored; local builds keep working unchanged). -->
    <SptPath Condition="'$(SptPath)' == '' And '$(SPT_PATH)' != ''">$(SPT_PATH)</SptPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(SptPath)/BepInEx/core/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- EscapeFromTarkov_Data is the folder name SPT installs on disk. It is a
         path, not the project name: do not "fix" it to match the renaming, the
         references would stop resolving. -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptPath)/EscapeFromTarkov_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(SptPath)/EscapeFromTarkov_Data/Managed/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(SptPath)/EscapeFromTarkov_Data/Managed/Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(SptPath)/EscapeFromTarkov_Data/Managed/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(SptPath)/EscapeFromTarkov_Data/Managed/Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptPath)/EscapeFromTarkov_Data/Managed/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptPath)/EscapeFromTarkov_Data/Managed/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckSptPath" BeforeTargets="BeforeCompile">
    <Error Condition="'$(SptPath)' == '' Or !Exists('$(SptPath)/BepInEx/core/BepInEx.dll')"
           Text="SptPath is not set to a real SPT install: build with -p:SptPath=/path/to/SPT or export SPT_PATH." />
  </Target>
</Project>
